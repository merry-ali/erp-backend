{
  "realm": "maiz-erp",
  "enabled": true,
  "displayName": "Sistema de Producción y Comercialización",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 120,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      {
        "name": "ADMIN"
      },
      {
        "name": "COMPRADOR"
      },
      {
        "name": "ALMACENERO"
      },
      {
        "name": "OPERARIO_PLANTA"
      },
      {
        "name": "VENDEDOR"
      }
    ]
  },
  "clients": [
    {
      "clientId": "maiz-spa",
      "name": "Portal ERP",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:4200/auth/callback",
        "http://127.0.0.1:4200/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "http://127.0.0.1:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/##http://127.0.0.1:4200/"
      },
      "defaultClientScopes": [
        "web-origins",
        "roles",
        "profile",
        "email"
      ],
      "protocolMappers": [
        {
          "name": "maiz-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "maiz-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
